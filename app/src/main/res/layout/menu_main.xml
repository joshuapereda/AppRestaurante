<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#343434">

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/top_background" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Botón de Cerrar Sesión -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="70dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:backgroundTint="@color/black"
            android:drawablePadding="0dp"
            android:textColor="#FFFFFF"
            app:cornerRadius="0pt"
            app:icon="@drawable/cerrarsesion"
            app:iconSize="30dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="60dp"
            android:text="MANTENIMIENTOS"
            android:textColor="#ffffff"
            android:textSize="40sp"
            android:layout_below="@id/btnCerrarSesion"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="60dp">

        <Button
            android:id="@+id/btnIngresarProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:backgroundTint="#E1A500"
            android:textColor="#000000"
            android:drawableLeft="@drawable/comida"
            android:text="Registrar Producto" />

        <Button
            android:id="@+id/btnIngresarCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="25dp"
            android:textColor="#000000"
            android:backgroundTint="#E1A500"
            android:drawableLeft="@drawable/productooo"
            android:text="Registrar Categoria" />

        <Button
            android:id="@+id/btnCerraMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="25dp"
            android:backgroundTint="#E1A500"
            android:textColor="#000000"
            android:drawableLeft="@drawable/regresar"
            android:text="Regresar" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
